# Copy to .env and adjust. Never commit .env.

# --- ports ------------------------------------------------------------
API_PORT=8080
WEB_PORT=8081

# --- server -----------------------------------------------------------
# Comma-separated origins permitted to call the API.
CLOSURE_ALLOWED_ORIGINS=http://localhost:8081
RUST_LOG=closure_server=info,tower_http=warn

# --- images -----------------------------------------------------------
CLOSURE_VERSION=dev

# --- CLI --------------------------------------------------------------
# Host the CLI talks to. Override per invocation with --host.
CLOSURE_HOST=http://localhost:8080
